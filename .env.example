# FIXI Environment Configuration
APP_NAME=FIXI
APP_VERSION=1.0.0
ENVIRONMENT=production

# Vision
CAMERA_INDEX=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=30
PERSON_DETECTION_CONFIDENCE=0.5
FACE_MATCH_THRESHOLD=0.55
FRAME_PROCESS_INTERVAL=0.1

# Speech
WHISPER_MODEL_SIZE=tiny.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
AUDIO_SAMPLE_RATE=16000
VAD_ENERGY_THRESHOLD=0.02
SILENCE_DURATION_THRESHOLD=1.2
MAX_RECORDING_DURATION=15.0

# LLM (Local Ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_TEMPERATURE=0.7
OLLAMA_TIMEOUT=30.0

# Memory
MAX_SHORT_TERM_TURNS=6
TOP_K_EPISODIC_MEMORIES=5
MEMORY_SIMILARITY_THRESHOLD=0.35

# Dashboard
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
